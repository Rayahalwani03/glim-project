import { useState } from "react";

const DonationCard = () => {
  const [customAmountVisible, setCustomAmountVisible] = useState(false);
  const [selectedOption, setSelectedOption] = useState("");
  const [donationAmount, setDonationAmount] = useState("");

  const handleAmountClicked = () => {
    setCustomAmountVisible(!customAmountVisible);
  };

  const handleOptionChange = (e) => {
    setSelectedOption(e.target.value);
  };

  const handleFormSubmit = (e) => {
    e.preventDefault();

    // Validate and handle form data
    if (!selectedOption && !donationAmount) {
      alert("Please select an option or enter a donation amount!");
      return;
    }

    console.log("Selected Option:", selectedOption);
    console.log("Donation Amount:", donationAmount);
    alert("Thank you for your donation!");
  };

  return (
    <div className="bg-gray-50 shadow rounded-md flex p-6 w-full max-w-full">
      {/* Image Section */}
      <div className="flex-shrink-0">
        <img
          id="case-img"
          src="/public/Images/littlegirl.png"
          alt="Amina's Journey"
          className="w-64 h-94 rounded-md"
        />
      </div>

      {/* Form Section */}
      <div className="ml-4 w-full max-w-full overflow-hidden">
        <form onSubmit={handleFormSubmit}>
          <div>
            <h1 id="case-title" className="text-2xl font-bold">
              Amina’s Journey to Motherhood
            </h1>
            <p
              id="case-story"
              className="text-sm mt-2 mb-2 break-words overflow-hidden"
            >
              sdsaidjasdjsdsaidjasdj...
            </p>
          </div>

          {/* Radio Buttons */}
          <fieldset className="mt-4">
            <legend className="text-lg font-semibold mb-2">
              Select an Option:
            </legend>
            <div className="flex flex-col">
              {["Option 1", "Option 2", "Option 3"].map((label, index) => (
                <div key={index} className="flex items-center">
                  <input
                    type="radio"
                    id={`option${index + 1}`}
                    name="option"
                    value={index + 1}
                    onChange={handleOptionChange}
                    checked={selectedOption === String(index + 1)}
                    className="mr-2"
                    required={!customAmountVisible}
                  />
                  <label htmlFor={`option${index + 1}`}>{label}</label>
                </div>
              ))}
            </div>
          </fieldset>

          {/* Custom Amount */}
          <div className="mt-4">
            <button
              type="button"
              onClick={handleAmountClicked}
              className="inline-block border-b-2 border-transparent hover:border-black"
            >
              Enter a custom donation amount:
            </button>

            {customAmountVisible && (
              <div className="mt-2">
                <input
                  className="w-52 bg-transparent text-sm border rounded-md px-3 py-2 transition duration-300 ease focus:outline-none focus:border-green-500 shadow-sm focus:shadow"
                  type="number"
                  id="donation-amount"
                  placeholder="Donation Amount"
                  min="1"
                  max="300"
                  value={donationAmount}
                  onChange={(e) => setDonationAmount(e.target.value)}
                  required={!selectedOption}
                />
              </div>
            )}
          </div>

          {/* Buttons */}
          <div className="space-x-4 text-white mt-6">
            <button type="button" className="bg-red-500 px-5 py-2 rounded">
              Cancel
            </button>
            <button
              type="submit"
              className="bg-green-500 px-5 py-2 rounded"
            >
              Go to Checkout
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

export default DonationCard;
